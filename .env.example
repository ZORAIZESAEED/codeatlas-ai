APP_NAME=CodeAtlas AI
APP_ENV=development
DATABASE_URL=sqlite:///./data/codeatlas.db
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Repository ingestion limits (bytes unless noted)
WORKSPACE_DIR=./data/workspaces
MAX_UPLOAD_BYTES=20971520
MAX_DOWNLOAD_BYTES=52428800
MAX_EXTRACTED_BYTES=209715200
MAX_ARCHIVE_ENTRIES=20000
MAX_INDEXED_FILE_BYTES=1048576
GITHUB_TIMEOUT_SECONDS=30

# Code analysis chunk limits
CHUNK_MAX_LINES=100
CHUNK_MAX_CHARS=4000
# Structural parsing limits (larger files are chunked by lines)
PARSE_MAX_FILE_BYTES=524288
PARSE_MAX_TOTAL_BYTES=52428800

# Semantic indexing (Milestone 3). The model downloads on first use into EMBEDDING_CACHE_DIR.
CHROMA_DIR=./data/chroma
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./data/models
EMBEDDING_BATCH_SIZE=4
# EMBEDDING_THREADS=4
# EMBEDDING_QUERY_PREFIX=
EMBEDDING_MAX_INPUT_CHARS=2000
INDEX_MAX_CHUNKS=50000
INDEX_TIMEOUT_SECONDS=1800

# Retrieval (weighted Reciprocal Rank Fusion)
SEARCH_MAX_LIMIT=50
SEARCH_CANDIDATE_POOL=50
RRF_K=60
RRF_WEIGHT_EXACT=1.0
RRF_WEIGHT_KEYWORD=1.0
RRF_WEIGHT_KEYWORD_NATURAL=0.25
RRF_WEIGHT_SEMANTIC=1.0
SEARCH_RERANK_DEFAULT=false

# AI chat (Milestone 4). Ollama runs locally; nothing is sent off this machine.
# No chat model is assumed: set LLM_MODEL to a model you have pulled (`ollama list`).
LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_MAX_CONTEXT_TOKENS=8192
# Optional cost estimate in USD per 1M tokens (only used when both are set)
# LLM_INPUT_COST_PER_MTOK=
# LLM_OUTPUT_COST_PER_MTOK=
RAG_SEARCH_MODE=hybrid
RAG_SEARCH_LIMIT=8
RAG_MAX_EVIDENCE=8
CHAT_HISTORY_TURNS=4
CHAT_HISTORY_MAX_TOKENS=1200
INVESTIGATION_PLANNER=auto
INVESTIGATION_MAX_STEPS=4
INVESTIGATION_MAX_TOOL_CALLS=10
INVESTIGATION_MAX_LINES_READ=800
INVESTIGATION_MAX_EVIDENCE=12
INVESTIGATION_MAX_LLM_REQUESTS=5
INVESTIGATION_TIMEOUT_SECONDS=900
