APP_NAME=CodeAtlas AI
APP_ENV=development
DATABASE_URL=sqlite:///./data/codeatlas.db
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Repository ingestion limits (bytes unless noted)
WORKSPACE_DIR=./data/workspaces
MAX_UPLOAD_BYTES=20971520
MAX_DOWNLOAD_BYTES=52428800
MAX_EXTRACTED_BYTES=209715200
MAX_ARCHIVE_ENTRIES=20000
MAX_INDEXED_FILE_BYTES=1048576
GITHUB_TIMEOUT_SECONDS=30

# Code analysis chunk limits
CHUNK_MAX_LINES=100
CHUNK_MAX_CHARS=4000
# Structural parsing limits (larger files are chunked by lines)
PARSE_MAX_FILE_BYTES=524288
PARSE_MAX_TOTAL_BYTES=52428800

# Semantic indexing (Milestone 3). The model downloads on first use into EMBEDDING_CACHE_DIR.
CHROMA_DIR=./data/chroma
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./data/models
EMBEDDING_BATCH_SIZE=4
# EMBEDDING_THREADS=4
# EMBEDDING_QUERY_PREFIX=
EMBEDDING_MAX_INPUT_CHARS=2000
INDEX_MAX_CHUNKS=50000
INDEX_TIMEOUT_SECONDS=1800

# Retrieval (weighted Reciprocal Rank Fusion)
SEARCH_MAX_LIMIT=50
SEARCH_CANDIDATE_POOL=50
RRF_K=60
RRF_WEIGHT_EXACT=1.0
RRF_WEIGHT_KEYWORD=1.0
RRF_WEIGHT_KEYWORD_NATURAL=0.25
RRF_WEIGHT_SEMANTIC=1.0
SEARCH_RERANK_DEFAULT=false
